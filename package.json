{
  "name": "@2lab.ai/ui",
  "version": "0.4.5",
  "description": "Agent UI components for 2lab — Web Components, zero runtime dependencies. Agent Inbox, Agent Run, Approval Card, AI Answer, Tool Call Card, Context Window, Compact Breakdown, Model Picker, Memory Panel, Agent Queue, Toaster, Agent Steering, Agent Tree.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2lab-ai/ui.git"
  },
  "homepage": "https://ui.2lab.ai",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-inbox": {
      "types": "./dist/components/agent-inbox/index.d.ts",
      "import": "./dist/agent-inbox.js"
    },
    "./agent-run": {
      "types": "./dist/components/agent-run/index.d.ts",
      "import": "./dist/agent-run.js"
    },
    "./ai-answer": {
      "types": "./dist/components/ai-answer/index.d.ts",
      "import": "./dist/ai-answer.js"
    },
    "./context-window": {
      "types": "./dist/components/context-window/index.d.ts",
      "import": "./dist/context-window.js"
    },
    "./model-picker": {
      "types": "./dist/components/model-picker/index.d.ts",
      "import": "./dist/model-picker.js"
    },
    "./memory-panel": {
      "types": "./dist/components/memory-panel/index.d.ts",
      "import": "./dist/memory-panel.js"
    },
    "./agent-queue": {
      "types": "./dist/components/agent-queue/index.d.ts",
      "import": "./dist/agent-queue.js"
    },
    "./tool-call-card": {
      "types": "./dist/components/tool-call-card/index.d.ts",
      "import": "./dist/tool-call-card.js"
    },
    "./compact-breakdown": {
      "types": "./dist/components/compact-breakdown/index.d.ts",
      "import": "./dist/compact-breakdown.js"
    },
    "./approval-card": {
      "types": "./dist/components/approval-card/index.d.ts",
      "import": "./dist/approval-card.js"
    },
    "./toaster": {
      "types": "./dist/components/toaster/index.d.ts",
      "import": "./dist/toaster.js"
    },
    "./agent-steering": {
      "types": "./dist/components/agent-steering/index.d.ts",
      "import": "./dist/agent-steering.js"
    },
    "./agent-tree": {
      "types": "./dist/components/agent-tree/index.d.ts",
      "import": "./dist/agent-tree.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs && node scripts/copy-assets.mjs && node scripts/check-dist.mjs",
    "build:site": "npm run build && vite build --config vite.site.config.ts && node scripts/copy-lib.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "verify": "npm run check && npm run typecheck && npm test && npm run build:site && npm run consumer-check",
    "consumer-check": "bash scripts/consumer-check.sh",
    "registry-check": "bash scripts/registry-check.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
